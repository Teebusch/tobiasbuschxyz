---
import DateSummary from '../components/DateSummary.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const { title, description, eyebrow, datePublished, dateModified } = Astro.props;
---

<BaseLayout
    title={title}
    description={description}
    eyebrow={eyebrow}
    datePublished={datePublished}
    dateModified={dateModified}
>
    <DateSummary datePublished={datePublished} dateModified={dateModified} />
    <article class="prose">
        <slot />
    </article>
</BaseLayout>
