---
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';

import '../styles/global.css';

import '@fontsource-variable/league-spartan';
import '@fontsource-variable/noto-sans';

const { title, description, eyebrow, datePublished, dateModified } = Astro.props;

import { ClientRouter } from 'astro:transitions';
import PageHeader from '../components/PageHeader.astro';
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.png" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <ClientRouter />
        <title>tobiasbusch.xyz - {title}</title>
    </head>
    <body>
        <div class="content-wrapper">
            <Navbar />
            <PageHeader title={title} description={description} eyebrow={eyebrow} />
            <main>
                <slot />
            </main>
            <Footer />
        </div>
    </body>
</html>

<style>
    .content-wrapper {
        display: grid;
        width: 100%;
        grid-template-columns: 1fr min(var(--breakpoint-lg), 100%) 1fr;
        grid-template-rows: auto auto 1fr auto;
        min-height: 100dvh;
        padding-inline: var(--space-400);
    }

    main {
        display: grid;
        grid-template-columns: subgrid;
        grid-column: 2/3;
    }
</style>
