---
import { Image } from 'astro:assets';
import me from './me.jpg';
---

<div class="blurb">
    <p>Kognitions&shy;wissenschaftler, UX-Engineer, Web&shy;entwickler. Lebt in Köln.</p>
    <Image
        src={me}
        alt="Foto von Tobias Busch"
        width={100}
        height={100}
        style="border-radius: 50%; box-shadow: rgba(50, 50, 93, 0.25) 0px 50px 100px -20px, rgba(0, 0, 0, 0.3) 0px 30px 60px -30px;"
    />
</div>
<div class="links">
    <a href="/about">Mehr über mich</a>
    <a href="/garden">Mein digitaler Garten</a>
</div>

<style>
    .blurb {
        display: flex;
        flex-direction: column-reverse;
        gap: var(--space-300);
        font-size: var(--font-size-2);
    }
    @media (min-width: 700px) {
        .blurb {
            flex-direction: row;
        }
    }
    .links {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        column-gap: var(--space-200);
        row-gap: var(--space-100);
        margin-block: var(--space-100);

        a::before {
            content: '→ ';
        }
    }
</style>
