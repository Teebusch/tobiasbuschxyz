---
import Center from './Center.astro';
---

<footer>
    <Center>
        <div class="links">
            <strong>Socials</strong>
            <a href="https://github.com/teebusch" target="_blank">Github</a>
            <a href="https://linkedin.com/in/tobias-busch" target="_blank">LinkedIn</a>
            <a href="https://www.instagram.com/tobilotti/" target="_blank">Insta</a>
            <strong>Contact</strong>
            <a href="mailto:hello@tobiasbusch.xyz" target="_blank">hello@tobiasbusch.xyz</a>
        </div>
    </Center>
</footer>

<style>
    footer {
        padding-top: var(--space-400);
    }

    .links {
        display: flex;
        flex-direction: column;
        gap: var(--space-200);
    }

    @media (min-width: 700px) {
        .links {
            flex-direction: row;
        }
    }
</style>
